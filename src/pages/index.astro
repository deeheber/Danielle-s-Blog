---
import { getCollection } from "astro:content"
import Layout from "@layouts/Layout.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import LinkButton from "@components/LinkButton.astro"
import Card from "@components/Card"
import postFilter from "@utils/postFilter"
import speakingData from "../data/speakingData.json"

const blog = await getCollection("blog")
const featuredProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
)

const selectedWritingIds = [
  "headless-claude-on-aws",
  "pour-one-out-for-infrastructure-composer",
  "trails-not-gates",
  "fargate-on-a-budget",
  "serverless-weather-reporting",
]
const publishedBlog = blog.filter(postFilter)
const selectedWriting = selectedWritingIds.map((id) => {
  const post = publishedBlog.find((post) => post.id === id)
  if (!post)
    throw new Error(`Selected writing post is missing or unpublished: ${id}`)
  return post
})

const selectedSpeakingTitles = [
  "Rethinking Serverless - AWS Community Day Bay Area",
  "CI/CD with the AWS CDK and GitHub Actions at a Startup",
  "AWS Anti-Patterns That Will Cost You Later",
  "Serverless Chats Ep. 25",
]
const allSpeaking = speakingData.flatMap(({ year, content }) =>
  content.map((appearance) => ({ ...appearance, year })),
)
const selectedSpeaking = selectedSpeakingTitles.map((title) => {
  const appearance = allSpeaking.find(
    (appearance) => appearance.title === title,
  )
  if (!appearance)
    throw new Error(`Selected speaking appearance is missing: ${title}`)
  return appearance
})
---

<Layout>
  <Header />
  <main id="main-content">
    <section
      aria-labelledby="introduction"
      class="pt-12 pb-4"
    >
      <h1
        id="introduction"
        class="text-3xl tracking-wide sm:text-4xl"
      >
        Make ship <span class="whitespace-nowrap">happen 🚢</span>
      </h1>
      <p class="mt-6 max-w-2xl leading-relaxed">
        I’m Danielle. I help teams spend less time fighting their tools and more
        time shipping software. My focus is platform and cloud engineering,
        mostly AWS. I also co-organize the Believe in Serverless community, and
        I’m an AWS Serverless Hero.
      </p>
    </section>

    <section
      id="featured-projects"
      aria-labelledby="featured-projects-heading"
      class="pt-8"
    >
      <h2 id="featured-projects-heading">Selected Projects</h2>
      <ul class="mt-6 space-y-10">
        {
          featuredProjects.map(({ id, data }) => (
            <li>
              <h3 class="text-xl leading-snug font-bold">
                <a
                  href={`/projects#${id}`}
                  class="project-title"
                >
                  {data.title}
                </a>
              </h3>
              <p class="mt-3 max-w-2xl leading-relaxed">{data.summary}</p>
            </li>
          ))
        }
      </ul>
      <div class="all-blog-btn-wrapper">
        <LinkButton href="/projects">
          All projects
          <svg xmlns="http://www.w3.org/2000/svg"
            ><path
              d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
            ></path>
          </svg>
        </LinkButton>
      </div>
    </section>

    <div>
      {
        selectedWriting.length > 0 && (
          <section id="selected-writing">
            <h2 tabindex="0">Selected Writing</h2>
            <ul>
              {selectedWriting.map(({ data, id }) => (
                <Card
                  href={`/blog/${id}/`}
                  frontmatter={data}
                  secHeading={false}
                />
              ))}
            </ul>
          </section>
        )
      }

      <div class="all-blog-btn-wrapper">
        <LinkButton href="/blog/">
          All writing
          <svg xmlns="http://www.w3.org/2000/svg"
            ><path
              d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
            ></path>
          </svg>
        </LinkButton>
      </div>

      {
        (
          <section id="selected-speaking">
            <h2 tabindex="0">Selected Speaking</h2>
            <ul>
              {selectedSpeaking.map((content) => (
                <li class="talk-list">
                  <a
                    href={content.link}
                    class="external-link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {content.title} ({content.year})
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="all-blog-btn-wrapper">
        <LinkButton href="/talks/">
          All speaking
          <svg xmlns="http://www.w3.org/2000/svg"
            ><path
              d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
            ></path>
          </svg>
        </LinkButton>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";
  #selected-writing {
    @apply pt-8;
  }
  #featured-projects h2,
  #selected-writing h2,
  #selected-speaking h2 {
    @apply text-2xl tracking-wide;
  }
  .project-title {
    @apply text-skin-accent inline-block underline decoration-dashed underline-offset-4 hover:underline sm:no-underline;
  }
  .all-blog-btn-wrapper {
    @apply mt-4 mb-8 text-center sm:mt-8;
  }

  .talk-list {
    @apply font-merri my-4 sm:my-8 sm:text-xl;
  }
</style>
