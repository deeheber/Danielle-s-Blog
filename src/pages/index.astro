---
import { getCollection } from "astro:content"
import Layout from "@layouts/Layout.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import LinkButton from "@components/LinkButton.astro"
import Card from "@components/Card"
import getSortedBlog from "@utils/getSortedBlogPosts"
import speakingData from "../data/speakingData.json"

const blog = await getCollection("blog")

const sortedblog = getSortedBlog(blog)
const recentblog = sortedblog.filter(({ data }) => !data.featured)

// Flatten and sort the speaking data
const flattenedData: { title: string; link: string; year: string }[] =
  speakingData.flatMap((yearData) =>
    yearData.content.map((content) => ({
      ...content,
      year: yearData.year,
    })),
  )

const sortedData = flattenedData.sort((a, b) => Number(b.year) - Number(a.year))
const latestFive = sortedData.slice(0, 5)
---

<Layout>
  <Header />
  <main id="main-content">
    <section
      aria-labelledby="introduction"
      class="pt-12 pb-4"
    >
      <h1
        id="introduction"
        class="text-3xl tracking-wide sm:text-4xl"
      >
        Make ship <span class="whitespace-nowrap">happen 🚢</span>
      </h1>
      <p class="mt-6 max-w-2xl leading-relaxed">
        I’m Danielle. I help teams spend less time fighting their tools and more
        time shipping software. My background is in cloud infrastructure, mostly
        AWS.
      </p>
    </section>

    <section>
      {
        recentblog.length > 0 && (
          <section id="recent-blog">
            <h2 tabindex="0">Recent Writing</h2>
            <ul>
              {recentblog.map(
                ({ data, id }, index) =>
                  index < 5 && (
                    <Card
                      href={`/blog/${id}/`}
                      frontmatter={data}
                      secHeading={false}
                    />
                  ),
              )}
            </ul>
          </section>
        )
      }

      <div class="all-blog-btn-wrapper">
        <LinkButton href="/blog/">
          All writing
          <svg xmlns="http://www.w3.org/2000/svg"
            ><path
              d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
            ></path>
          </svg>
        </LinkButton>
      </div>

      {
        (
          <section id="recent-talks">
            <h2 tabindex="0">Recent Speaking</h2>
            <ul>
              {latestFive.map((content) => (
                <li id="talk-list">
                  <a
                    href={content.link}
                    class="external-link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {content.title} ({content.year})
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="all-blog-btn-wrapper">
        <LinkButton href="/talks/">
          All speaking
          <svg xmlns="http://www.w3.org/2000/svg"
            ><path
              d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
            ></path>
          </svg>
        </LinkButton>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";
  #recent-blog {
    @apply pt-8;
  }
  #recent-blog h2,
  #recent-talks h2 {
    @apply text-2xl tracking-wide;
  }
  .all-blog-btn-wrapper {
    @apply my-8 text-center;
  }

  #talk-list {
    @apply font-merri my-4 sm:my-8 sm:text-xl;
  }
</style>
