---
import { getCollection } from "astro:content"
import Layout from "@layouts/Layout.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"
import LinkButton from "@components/LinkButton.astro"
import Card from "@components/Card"
import postFilter from "@utils/postFilter"
import speakingData from "../data/speakingData.json"

const blog = await getCollection("blog")
const featuredProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
)

const selectedWritingIds = [
  "headless-claude-on-aws",
  "pour-one-out-for-infrastructure-composer",
  "trails-not-gates",
  "fargate-on-a-budget",
  "serverless-weather-reporting",
]
const publishedBlog = blog.filter(postFilter)
const selectedWriting = selectedWritingIds.map((id) => {
  const post = publishedBlog.find((post) => post.id === id)
  if (!post)
    throw new Error(`Selected writing post is missing or unpublished: ${id}`)
  return post
})

const selectedSpeakingTitles = [
  "Rethinking Serverless - AWS Community Day Bay Area",
  "CI/CD with the AWS CDK and GitHub Actions at a Startup",
  "AWS Anti-Patterns That Will Cost You Later",
  "Serverless Chats Ep. 25",
]
const allSpeaking = speakingData.flatMap(({ year, content }) =>
  content.map((appearance) => ({ ...appearance, year })),
)
const selectedSpeaking = selectedSpeakingTitles.map((title) => {
  const appearance = allSpeaking.find(
    (appearance) => appearance.title === title,
  )
  if (!appearance)
    throw new Error(`Selected speaking appearance is missing: ${title}`)
  return appearance
})
---

<Layout>
  <Header />
  <main id="main-content">
    <section
      aria-labelledby="introduction"
      class="pt-12 sm:pt-20"
    >
      <h1
        id="introduction"
        class="text-4xl leading-tight sm:text-5xl"
      >
        Make ship happen.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed sm:text-xl">
        I’m Danielle. I help teams spend less time fighting their tools and more
        time shipping software. My focus is platform and cloud engineering,
        mostly AWS. I also co-organize the Believe in Serverless community, and
        I’m an AWS Serverless Hero.
      </p>
    </section>

    <section
      id="featured-projects"
      aria-labelledby="featured-projects-heading"
      class="mt-16 sm:mt-24"
    >
      <h2 id="featured-projects-heading">Selected Projects</h2>
      <ul class="mt-6 grid gap-10 md:grid-cols-3">
        {featuredProjects.map(({ id, data }) => <li>
          <h3 class="text-lg leading-snug">
            <a
              href={`/projects#${id}`}
              class="item-link"
            >
              {data.title}
            </a>
          </h3>
          <p class="text-skin-muted mt-2 text-base leading-relaxed">
            {data.summary}
          </p>
        </li>)}
      </ul>
      <LinkButton
        href="/projects"
        className="all-link"
      >
        All projects
        <svg xmlns="http://www.w3.org/2000/svg">
          <path
            d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
          ></path>
        </svg>
      </LinkButton>
    </section>

    <div
      class="mx-auto mt-16 mb-20 grid max-w-4xl gap-16 sm:mt-24 sm:mb-28 md:grid-cols-2 md:gap-x-8"
    >
      <section id="selected-writing">
        <h2>Selected Writing</h2>
        <ul>
          {selectedWriting.map(({ data, id }) => (
            <Card
              href={`/blog/${id}/`}
              frontmatter={data}
              secHeading={false}
            />
          ))}
        </ul>
        <LinkButton
          href="/blog/"
          className="all-link"
        >
          All writing
          <svg xmlns="http://www.w3.org/2000/svg">
            <path
              d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
            ></path>
          </svg>
        </LinkButton>
      </section>

      <section id="selected-speaking">
        <h2>Selected Speaking</h2>
        <ul>
          {selectedSpeaking.map((content) => <li class="talk-row">
            <a
              href={content.link}
              class="item-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {content.title}
            </a>
            <span class="text-skin-muted shrink-0 text-sm italic"
              >{content.year}</span
            >
          </li>)}
        </ul>
        <LinkButton
          href="/talks/"
          className="all-link"
        >
          All speaking
          <svg xmlns="http://www.w3.org/2000/svg">
            <path
              d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"
            ></path>
          </svg>
        </LinkButton>
      </section>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";
  main h2 {
    @apply text-skin-muted text-sm font-semibold tracking-widest uppercase;
  }
  .item-link {
    @apply text-skin-accent underline-offset-4 hover:underline hover:decoration-2 focus-visible:underline [@media(hover:none)]:underline;
  }
  .talk-row {
    @apply flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6;
  }
  .talk-row a {
    @apply text-lg leading-snug font-medium;
  }
  .all-link {
    @apply mt-6 flex w-fit items-center gap-1 text-base font-bold;
  }
</style>
