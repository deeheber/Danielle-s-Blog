---
import { getCollection, render } from "astro:content"
import { SITE } from "@config"
import Layout from "@layouts/Layout.astro"
import Header from "@components/Header.astro"
import Footer from "@components/Footer.astro"

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
)
const renderedProjects = await Promise.all(
  projects.map(async (project) => ({ project, ...(await render(project)) })),
)
---

<Layout
  title={`Projects | ${SITE.title}`}
  description="Projects in AI developer tooling and serverless architecture, with the decisions, tradeoffs, and lessons behind them."
  canonicalURL={new URL("/projects/", Astro.site).href}
>
  <Header activeNav="projects" />
  <main
    id="main-content"
    class="container-content mt-8 mb-28"
  >
    <div class="prose max-w-3xl">
      <h1 class="text-skin-accent text-2xl tracking-wider sm:text-3xl">
        Projects
      </h1>
      <p>Here are a few things I've built and what I learned along the way.</p>

      {
        renderedProjects.map(({ project, Content }) => (
          <section
            class="featured-project"
            aria-labelledby={project.id}
          >
            <h2 id={project.id}>{project.data.title}</h2>
            <Content />
          </section>
        ))
      }

      <section aria-labelledby="other-projects">
        <h2 id="other-projects">More projects</h2>
        <ul>
          <li>
            <strong
              ><a
                href="https://github.com/deeheber/job-search-agent"
                target="_blank"
                rel="noopener noreferrer"
                >job-search-agent</a
              >:</strong
            > A Strands/Bedrock AgentCore example for finding open roles.
            <a href="/blog/job-search-agent/">Read the write-up</a>.
          </li>
          <li>
            <a
              href="https://github.com/deeheber"
              target="_blank"
              rel="noopener noreferrer"
              >More on GitHub</a
            >
          </li>
        </ul>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  @reference "../styles/base.css";
  section {
    padding: 0;
  }
  section + section {
    margin-top: 5rem;
  }
  h2 {
    scroll-margin-top: 2rem;
  }
  .featured-project > h2 {
    @apply text-xl leading-[1.3] sm:text-2xl;
  }
  .prose :global(h3) {
    @apply text-lg/[1.6] sm:text-xl/[1.6];
  }
  .prose :global(summary) {
    @apply disclosure-summary;
  }
</style>
