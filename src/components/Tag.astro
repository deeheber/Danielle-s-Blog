---
export interface Props {
  tag: string
  size?: "sm" | "lg"
}

const { tag, size = "sm" } = Astro.props
---

<li class={`inline-block ${size === "lg" ? "mx-2 my-1" : ""}`}>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class={size === "sm" ? "text-sm" : "text-lg"}
  >
    {tag}
  </a>
</li>

<style>
  @reference "../styles/base.css";
  a {
    @apply text-skin-accent font-semibold underline underline-offset-4 hover:decoration-2;
  }
</style>
