---
import speakingData from "../data/speakingData.json"

const years = speakingData.filter(({ content }) => content.length > 0)
const latestYear = Math.max(...years.map(({ year }) => Number(year)))
---

<section>
  {
    years.map((year) => (
      <details open={Number(year.year) === latestYear}>
        <summary>{year.year}</summary>
        <ul>
          {year.content.map((talk) => (
            <li>
              <a
                href={talk.link}
                class="external-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                {talk.title}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))
  }

  <style>
    @reference "../styles/base.css";
    section {
      @apply w-full pb-4;
    }
    details {
      @apply pb-4;
    }
    summary {
      @apply disclosure-summary;
    }
    li {
      @apply mt-2 mb-6 text-xl font-medium;
    }
  </style>
</section>
