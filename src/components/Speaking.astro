---
import speakingData from "../data/speakingData.json"

const years = speakingData.filter(({ content }) => content.length > 0)
const latestYear = Math.max(...years.map(({ year }) => Number(year)))
---

<section>
  {years.map((year) => <details open={Number(year.year) === latestYear}>
    <summary>{year.year}</summary>
    <ul>
      {year.content.map((talk) => <li>
        <a
          href={talk.link}
          target="_blank"
          rel="noopener noreferrer"
        >
          {talk.title}
        </a>
      </li>)}
    </ul>
  </details>)}

  <style>
    @reference "../styles/base.css";
    section {
      @apply w-full pb-4;
    }
    details {
      @apply pb-4;
    }
    summary {
      @apply disclosure-summary;
    }
    li {
      @apply py-3;
    }
    li a {
      @apply font-merri text-skin-accent text-lg leading-snug underline-offset-4 hover:underline focus-visible:underline [@media(hover:none)]:underline;
    }
  </style>
</section>
