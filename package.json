{
  "name": "danielle-blog",
  "version": "5.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "npm run type-check && astro build",
    "compress-images": "bash scripts/compress-images.sh",
    "dev": "astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix",
